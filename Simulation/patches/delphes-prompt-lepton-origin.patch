 //------------------------------------------------------------------------------
+
+Bool_t LeptonDressing::HasBosonAncestor(const Candidate *candidate) const
+{
+  vector<Int_t> pending;
+  set<Int_t> visited;
+  const Int_t leptonPID = TMath::Abs(candidate->PID);
+  AddMothers(candidate, pending);
+
+  while(!pending.empty())
+  {
+    const Int_t index = pending.back();
+    pending.pop_back();
+    if(index < 0 || index >= fParticleInputArray->GetEntriesFast()) continue;
+    if(!visited.insert(index).second) continue;
+
+    const Candidate *ancestor = static_cast<const Candidate *>(fParticleInputArray->At(index));
+    if(!ancestor) continue;
+    const Int_t absolutePID = TMath::Abs(ancestor->PID);
+    if(absolutePID == 23 || absolutePID == 24) return true;
+    if(absolutePID == 22 && ancestor->Momentum.M() > fVirtualPhotonMinMass) return true;
+
+    // Follow status copies of the same lepton and, when explicitly enabled,
+    // tau-decay chains.  Low-mass photons are not followed, which excludes
+    // conversion electrons while retaining hard gamma* -> ll decays.
+    if(absolutePID == leptonPID || (fAllowTauDecayCandidate && absolutePID == 15))
+    {
+      AddMothers(ancestor, pending);
+    }
+  }
+  return false;
+}
+
+//------------------------------------------------------------------------------
+
+Bool_t LeptonDressing::IsCandidateEligible(const Candidate *candidate) const
+{
+  if(fRequireNoHadronAncestorCandidate && HasHadronAncestor(candidate)) return false;
+  if(fRequireBosonAncestorCandidate && !HasBosonAncestor(candidate)) return false;
+  return true;
+}
